<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileStrider.MauiApp.ViewModels"
        xmlns:models="using:FileStrider.Core.Models"
        xmlns:controls="using:FileStrider.MauiApp.Controls"
        x:Class="FileStrider.MauiApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}" Icon="/Assets/filestrider-icon.ico"
        Width="1280" Height="860" MinWidth="1040" MinHeight="700">
    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>
    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="File Strider" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AppSubtitle}" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding AboutLabel}" Command="{Binding ShowAboutCommand}"
                    VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="1" Padding="12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding SelectedPath}" IsEnabled="{Binding CanScan}"
                             Watermark="{Binding ScanPathLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding BrowseLabel}" Command="{Binding SelectFolderCommand}"/>
                    <Button Grid.Column="2" Content="{Binding QuickScanLabel}" Command="{Binding QuickScanCommand}"/>
                    <Button Grid.Column="3" Content="{Binding StartScanLabel}" Command="{Binding StartScanCommand}"
                            Background="#137E67" Foreground="White" Padding="18,7"/>
                </Grid>

                <TextBlock x:Name="ScanStatusMessage" Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap"/>
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding CanScan}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                        <TextBlock Text="{Binding TopNLabel}" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding TopN}" Minimum="1" Maximum="200" FormatString="0" Width="120"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IncludeHidden}" Content="{Binding IncludeHiddenLabel}" Margin="0,0,16,6"/>
                    <CheckBox IsChecked="{Binding FoldersOnly}" Content="{Binding FoldersOnlyLabel}"
                              ToolTip.Tip="{Binding FoldersOnlyTooltip}" Margin="0,0,16,6"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                        <TextBlock Text="{Binding MinSizeLabel}" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding MinFileSize}" Minimum="0" Maximum="{Binding MaximumMinFileSize}"
                                       FormatString="0.##" Width="120"/>
                        <ComboBox ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding SelectedSizeUnit}" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                        <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Width="125">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding NativeName}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsEnabled="{Binding CanScan}">
                    <TextBlock Text="{Binding RecentFoldersLabel}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RecentPaths}" SelectedItem="{Binding SelectedRecentPath}"
                              HorizontalAlignment="Stretch" MaxDropDownHeight="250"/>
                    <Button Grid.Column="2" Content="{Binding SaveSettingsLabel}" Command="{Binding SaveSettingsCommand}"/>
                </Grid>
                <Expander Header="{Binding AdvancedOptionsLabel}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" IsEnabled="{Binding CanScan}">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6">
                                <TextBlock Text="{Binding DepthLabel}" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding MaxDepth}" Minimum="0" Maximum="10000" FormatString="0" Width="90"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6">
                                <TextBlock Text="{Binding ConcurrencyLabel}" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding ConcurrencyLimit}" Minimum="1"
                                               Maximum="{Binding MaximumConcurrency}" FormatString="0" Width="80"/>
                            </StackPanel>
                            <CheckBox Content="{Binding FollowSymlinksLabel}" IsChecked="{Binding FollowSymlinks}"/>
                        </WrapPanel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                            <TextBlock Text="{Binding ExcludePatternsLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ExcludePatternsText}"/>
                            <TextBlock Grid.Row="1" Text="{Binding ExcludeDirectoriesLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExcludeDirectoriesText}"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="*,1.1*" RowSpacing="12">
            <Grid ColumnDefinitions="*,*,0.9*" ColumnSpacing="10">
                <Border Padding="10" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="{Binding LargestFilesLabel}" FontSize="15" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding TopFiles}" DoubleTapped="TopFilesList_DoubleTapped"
                                 >
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <StackPanel Spacing="3" Margin="2,4" ToolTip.Tip="{Binding FullPath}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="10" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="{Binding LargestFoldersLabel}" FontSize="15" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding TopFolders}" DoubleTapped="TopFoldersList_DoubleTapped"
                                 >
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderItem">
                                    <StackPanel Spacing="3" Margin="2,4" ToolTip.Tip="{Binding FullPath}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="10" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="{Binding FileTypeBreakdownLabel}" FontSize="15" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding FileTypeStatistics}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FileTypeStats">
                                    <StackPanel Spacing="4" Margin="2,5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="5"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0:N0}'}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding DiskUsageVisualizationLabel}" FontSize="15" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="{Binding UpLabel}" Command="{Binding NavigateUpCommand}"
                                IsEnabled="{Binding CanNavigateUp}" Padding="10,3"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding TreemapPath}" ToolTip.Tip="{Binding TreemapHint}"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <controls:TreemapControl Grid.Row="2" Items="{Binding TreemapItems}"
                                             EmptyText="{Binding TreemapEmptyText}" ItemClicked="Treemap_ItemClicked"
                                             ClipToBounds="True"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding ScanStats}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CoverageSummary}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CurrentPath}" FontSize="11" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsScanning}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="{Binding CancelLabel}" Command="{Binding CancelScanCommand}" IsVisible="{Binding CanCancel}"/>
                <Button Content="{Binding ExportCsvLabel}" Command="{Binding ExportToCsvCommand}" IsEnabled="{Binding HasResults}"/>
                <Button Content="{Binding ExportJsonLabel}" Command="{Binding ExportToJsonCommand}" IsEnabled="{Binding HasResults}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
